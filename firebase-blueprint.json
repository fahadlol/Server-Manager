{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the Staff Manager platform.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "minecraftUsername": { "type": "string" },
        "minecraftUuid": { "type": "string" },
        "discordUsername": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "mod", "helper", "user"] },
        "servers": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "email", "role"]
    },
    "Server": {
      "title": "Server",
      "description": "A managed server.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri" },
        "websiteUrl": { "type": "string", "format": "uri" },
        "ownerUid": { "type": "string" },
        "theme": {
          "type": "object",
          "properties": {
            "primaryColor": { "type": "string" },
            "secondaryColor": { "type": "string" }
          }
        },
        "staff": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "ownerUid"]
    },
    "Punishment": {
      "title": "Punishment",
      "description": "A punishment log.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serverId": { "type": "string" },
        "playerUsername": { "type": "string" },
        "staffUid": { "type": "string" },
        "type": { "type": "string", "enum": ["warn", "mute", "tempban", "permban"] },
        "reason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "proofUrl": { "type": "string", "format": "uri" },
        "active": { "type": "boolean" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "serverId", "playerUsername", "staffUid", "type", "reason", "timestamp"]
    },
    "LOA": {
      "title": "Leave of Absence",
      "description": "A staff leave of absence request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staffUid": { "type": "string" },
        "serverId": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["id", "staffUid", "serverId", "startDate", "endDate", "reason", "status"]
    },
    "Thread": {
      "title": "Thread",
      "description": "A discussion thread or request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serverId": { "type": "string" },
        "title": { "type": "string" },
        "authorUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "authorUid": { "type": "string" },
              "content": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "required": ["id", "serverId", "title", "authorUid", "createdAt"]
    },
    "Invite": {
      "title": "Invite",
      "description": "A staff invitation code.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "mod", "helper"] },
        "serverId": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "used": { "type": "boolean" },
        "usedBy": { "type": "string" }
      },
      "required": ["id", "code", "role", "createdBy", "createdAt", "used"]
    },
    "StaffNote": {
      "title": "Staff Note",
      "description": "A private note about a staff member, visible only to admins and owners.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetUid": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetUid", "authorUid", "authorName", "content", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A notification for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "link": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "type", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "User", "description": "User profiles." },
    "/servers/{serverId}": { "schema": "Server", "description": "Server configurations." },
    "/punishments/{punishmentId}": { "schema": "Punishment", "description": "Punishment logs." },
    "/loas/{loaId}": { "schema": "LOA", "description": "Leave of absence requests." },
    "/threads/{threadId}": { "schema": "Thread", "description": "Discussion threads." },
    "/invites/{inviteId}": { "schema": "Invite", "description": "Staff invitation codes." },
    "/staff_notes/{noteId}": { "schema": "StaffNote", "description": "Private notes about staff members." },
    "/notifications/{notificationId}": { "schema": "Notification", "description": "User notifications." },
    "/servers/{serverId}/announcements/{announcementId}": { "schema": { "type": "object" }, "description": "Server announcements." },
    "/servers/{serverId}/rules/{ruleId}": { "schema": { "type": "object" }, "description": "Server rules." },
    "/servers/{serverId}/guides/{guideId}": { "schema": { "type": "object" }, "description": "Server guides." }
  }
}
